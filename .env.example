# StockSense Environment Configuration Example

# Backend Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL-ready with SQLite fallback for local hackathon development)
# For SQLite (default local): sqlite:///./stocksense.db
# For PostgreSQL: postgresql://username:password@localhost:5432/stocksense_db
DATABASE_URL=sqlite:///./stocksense.db

# Security & Authentication
# Generate a secure 32+ character random secret in production
JWT_SECRET_KEY=stocksense-hackathon-super-secret-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Password Reset OTP settings
OTP_EXPIRE_MINUTES=15

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
