# Backend Environment Variables
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database URL:
# SQLite (default for instant hackathon dev): sqlite:///./stocksense.db
# PostgreSQL: postgresql://username:password@localhost:5432/stocksense_db
DATABASE_URL=sqlite:///./stocksense.db

# JWT & Security
JWT_SECRET_KEY=stocksense-hackathon-super-secret-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OTP Settings
OTP_EXPIRE_MINUTES=15
